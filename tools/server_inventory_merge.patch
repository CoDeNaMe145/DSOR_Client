+    def merge_stacks(self, source_id: int, target_id: int, *, storage_name: str,
+                     max_stack_size: int) -> int:
+        """Merge into the selected stack, retaining any overflow in its source slot."""
+        if source_id == target_id:
+            raise ValueError("cannot merge a stack into itself")
+        source, target = self.item(source_id), self.item(target_id)
+        if storage_name not in self.STORAGE_NAMES or target_id not in getattr(self.inventory, storage_name):
+            raise ValueError("merge destination does not belong to the requested storage")
+        if not any(source_id in getattr(self.inventory, name) for name in self.STORAGE_NAMES):
+            raise ValueError("merge source must be in storage")
+        fields = ("template_id", "item_level", "field_08", "socket_count", "field_11", "field_12",
+                  "field_20", "field_1c", "field_28", "field_3c", "field_3d", "field_34",
+                  "field_38", "field_80", "field_88", "field_f8", "field_3e", "quest_id",
+                  "enchantments", "socketed_templates")
+        if any(getattr(source, f) != getattr(target, f) for f in fields):
+            raise ValueError("these items cannot share a stack")
+        moved = min(int(source.amount), int(max_stack_size) - int(target.amount))
+        if int(max_stack_size) <= 1 or moved <= 0:
+            raise ValueError("destination stack is full or not stackable")
+        old_value, old_amount = int(source.field_30), int(source.amount)
+        moved_value = old_value * moved // old_amount
+        self.consume(source_id, moved)
+        if moved < old_amount:
+            remaining = self.item(self.next_item_id - 1)
+            remaining.field_30 = old_value - moved_value
+            for item in self.changed_items:
+                if item.item_id == remaining.item_id:
+                    item.field_30 = remaining.field_30
+        new_id = self.next_item_id
+        self.next_item_id += 1
+        target.item_id = new_id
+        target.field_18 = new_id & 0xFFFF
+        target.amount += moved
+        target.field_30 += moved_value
+        _replace_item_id(self.inventory, target_id, new_id)
+        self.removed_item_ids.append(target_id)
+        self.replacements[new_id] = target_id
+        self.changed_items.append(copy.deepcopy(target))
+        return moved
