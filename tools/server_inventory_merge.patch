@@ -0,0 +1,46 @@
+"""Drag-to-stack mutations preserve quantities, allocations and identity updates."""
+import unittest
+from dso_server.protocol.inventory_codec import InventoryInfo, ItemInfo
+from dso_server.protocol.inventory_economy_protocol import InventoryMutationBuilder
+
+
+class InventoryMergeTests(unittest.TestCase):
+    def inventory(self):
+        return InventoryInfo(items=[ItemInfo(1, amount=10, template_id="potion", field_30=100),
+                                    ItemInfo(2, amount=8, template_id="potion", field_30=80)],
+                             storage_58={1: 0, 2: 1}, storage_size=21)
+
+    def test_complete_merge_rekeys_target_and_frees_source(self):
+        original = self.inventory()
+        builder = InventoryMutationBuilder(original, 10)
+        self.assertEqual(builder.merge_stacks(1, 2, storage_name="storage_58", max_stack_size=99), 10)
+        result = builder.finish()
+        self.assertEqual([(i.item_id, i.amount, i.field_30) for i in result.inventory.items], [(10, 18, 180)])
+        self.assertEqual(result.inventory.storage_58, {10: 1})
+        self.assertEqual(result.delta.field_158, {10: 2})
+        self.assertEqual(set(result.delta.changed_item_ids), {1, 2})
+        self.assertEqual(result.final.items, [])
+        self.assertEqual(original.storage_58, {1: 0, 2: 1})
+
+    def test_overflow_leaves_source_in_its_slot(self):
+        builder = InventoryMutationBuilder(self.inventory(), 10)
+        self.assertEqual(builder.merge_stacks(1, 2, storage_name="storage_58", max_stack_size=12), 4)
+        result = builder.finish()
+        self.assertEqual(result.inventory.storage_58, {10: 0, 11: 1})
+        self.assertEqual([(i.amount, i.field_30) for i in result.inventory.items], [(6, 60), (12, 120)])
+        self.assertEqual(result.delta.field_158, {10: 1, 11: 2})
+
+    def test_rejects_incompatible_full_or_wrong_storage_without_mutation(self):
+        for mode in ["different", "full", "wrong_storage", "equipped", "self"]:
+            inventory = self.inventory()
+            if mode == "different": inventory.items[1].template_id = "another"
+            if mode == "equipped": inventory.storage_58.pop(1); inventory.equipment_slots[1] = (23,)
+            builder = InventoryMutationBuilder(inventory, 10)
+            with self.assertRaises(ValueError):
+                builder.merge_stacks(1, 1 if mode == "self" else 2,
+                    storage_name="storage_a8" if mode == "wrong_storage" else "storage_58",
+                    max_stack_size=8 if mode == "full" else 99)
+            self.assertEqual([i.amount for i in inventory.items], [10, 8])
+
+
+if __name__ == "__main__": unittest.main()
